---
interface Props {
  address: string;
  phone: string;
  photos: string[];
}

const { address, phone, photos } = Astro.props;
---

<section id="location" class="py-24 px-6 relative z-10 bg-black border-t border-white/10">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Info Left Column -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-koa-amber block mb-2">Visit KOA Erbil</span>
          <h2 class="font-display font-black text-3xl sm:text-5xl text-white tracking-tight">
            Meet Us at Erbil Boulevard
          </h2>
          <p class="font-kurdish text-lg text-koa-latte/80 mt-2">
            وەرە سەردانمان بکە لە هەولێر بۆلیڤارد!
          </p>
        </div>

        <div class="space-y-4">
          <div class="p-5 rounded-2xl bg-koa-surface border border-white/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-koa-amber/10 border border-koa-amber/30 flex items-center justify-center text-koa-amber shrink-0 mt-1">
              📍
            </div>
            <div>
              <h4 class="font-mono text-xs uppercase tracking-wider text-white font-semibold">Address</h4>
              <p class="text-sm text-koa-latte/80 mt-1">{address}</p>
              <p class="text-xs text-koa-cream/50 mt-0.5">Naz naz, Erbil, Erbil Governorate 44001</p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-koa-surface border border-white/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-koa-amber/10 border border-koa-amber/30 flex items-center justify-center text-koa-amber shrink-0 mt-1">
              📞
            </div>
            <div>
              <h4 class="font-mono text-xs uppercase tracking-wider text-white font-semibold">Direct Inquiries</h4>
              <a href={`tel:${phone.replace(/\s+/g, '')}`} class="text-sm text-koa-gold hover:underline font-mono mt-1 block">
                {phone}
              </a>
              <span class="text-xs text-koa-cream/50">Reservations & Car Delivery Pickups</span>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-koa-surface border border-white/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-koa-amber/10 border border-koa-amber/30 flex items-center justify-center text-koa-amber shrink-0 mt-1">
              🕒
            </div>
            <div>
              <h4 class="font-mono text-xs uppercase tracking-wider text-white font-semibold">Operating Schedule</h4>
              <p class="text-sm text-emerald-400 font-mono mt-1 font-medium">Open Everyday: 8:00 AM – 12:00 AM (Midnight)</p>
              <span class="text-xs text-koa-cream/50">Morning coffees, afternoon workspaces, evening hangouts</span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 pt-2">
          <a 
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("KOA CAFE Naz naz Erbil Erbil Governorate")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-xl bg-koa-amber text-black font-display font-bold text-xs uppercase tracking-wider hover:bg-white transition-all shadow-lg shadow-koa-amber/20 hover:scale-105"
          >
            Open in Google Maps ↗
          </a>
          <a 
            href="https://lezzoo.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-xl border border-white/20 text-white font-display font-bold text-xs uppercase tracking-wider hover:border-koa-amber hover:text-koa-amber transition-all"
          >
            Order Delivery ↗
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Spatial Location Card -->
      <div class="lg:col-span-7">
        <div class="relative rounded-3xl overflow-hidden border border-white/15 bg-koa-surface shadow-2xl group">
          <!-- Stylized Map Placeholder with Real Venue Imagery Overlay -->
          <div class="relative h-[480px] w-full overflow-hidden">
            <img 
              src={photos[8] || photos[0]} 
              alt="KOA Cafe Location Exterior" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-90 contrast-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

            <!-- Floating Geo Marker Card -->
            <div class="absolute top-8 left-8 right-8 sm:right-auto sm:max-w-xs p-5 rounded-2xl bg-black/80 backdrop-blur-xl border border-white/20 shadow-2xl animate-float-slow">
              <div class="flex items-center gap-3 mb-2">
                <span class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="font-mono text-xs uppercase text-koa-amber font-semibold tracking-wider">Live Coordinates</span>
              </div>
              <h3 class="font-display font-black text-lg text-white">Erbil Boulevard Branch</h3>
              <p class="text-xs text-koa-latte/80 font-mono mt-1">36.1901° N, 43.9930° E</p>
              <div class="mt-3 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-koa-gold">
                <span>Google Rating: 4.4 / 5.0</span>
                <span>⭐ 119</span>
              </div>
            </div>

            <!-- Bottom Floating Quick-Contact Strip -->
            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-black/70 backdrop-blur-md border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono">
              <span class="text-koa-latte/80">Rolling down your window? We deliver straight to your car curb.</span>
              <a href={`tel:${phone.replace(/\s+/g, '')}`} class="px-3 py-1.5 rounded-lg bg-koa-amber/20 text-koa-gold border border-koa-amber/50 hover:bg-koa-amber hover:text-black transition-colors shrink-0">
                Call {phone}
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>